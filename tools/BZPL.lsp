;;; BZPL.lsp —— 多段线逐段快速对齐标注 (每段外侧自动放DIMALIGNED标注)
;;; 加载: APPLOAD 选本文件; 用法: 命令行输入 BZPL, 选一条多段线, 输字高(默认图纸比例自适应)
(vl-load-com)
(defun c:BZPL ( / ent obj coords n i p1 p2 mid ang off pt3 h)
  (setq ent (car (entsel "\n选择多段线(直线也可): ")))
  (if ent
    (progn
      (setq obj (vlax-ename->vla-object ent))
      (if (vlax-property-available-p obj 'Coordinates)
        (progn
          (setq coords (vlax-get obj 'Coordinates))
          (setq n (/ (length coords) 2))
          (if (equal (vlax-get obj 'Closed) :vlax-true) (setq n (1- n)))
          (setq h (getreal "\n标注文字/尺寸线偏移高度<按图比例填, 如500>: "))
          (if (null h) (setq h 500.0))
          (setq i 0)
          (while (< i n)
            (setq p1 (list (nth (* 2 i) coords) (nth (1+ (* 2 i) ) coords) 0.0))
            (if (< (1+ i) n)
              (setq p2 (list (nth (* 2 (1+ i)) coords) (nth (1+ (* 2 (1+ i))) coords) 0.0))
              (setq p2 (list (nth 0 coords) (nth 1 coords) 0.0))
            )
            ;; 外法线方向偏移(按段走向左转90°; 闭合线为顺时针时可改负值)
            (setq mid (mapcar '(lambda (a b) (/ (+ a b) 2.0)) p1 p2))
            (setq ang (+ (angle p1 p2) (/ pi 2.0)))
            (setq pt3 (polar mid ang h))
            (command "_.DIMALIGNED" "_non" p1 "_non" p2 "_non" pt3)
            (setq i (1+ i))
          )
          (princ (strcat "\n完成, 共标注 " (itoa n) " 段。"))
        )
        (princ "\n所选对象无坐标属性(可能不是多段线), 请换LWPOLYLINE。")
      )
    )
  )
  (princ)
)
(princ "\nBZPL.lsp 已加载, 命令: BZPL")